<?xml version="1.0" encoding="utf-8"?>
<MA xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.malighting.de/grandma2/xml/MA" xsi:schemaLocation="http://schemas.malighting.de/grandma2/xml/MA http://schemas.malighting.de/grandma2/xml/3.9.60/MA.xsd" major_vers="3" minor_vers="9" stream_vers="60">
	<Info datetime="2026-09-27T12:00:00" showfile="" />
	<Macro index="0" name="FULL SONG CREATOR">
		<Macroline index="0">
			<text>ClearAll</text>
		</Macroline>
		<Macroline index="1">
			<text>SetUserVar $SongName = ( Song Name ? )</text>
		</Macroline>
		<Macroline index="2">
			<text>SetUserVar $PageNum = ( Page Number ? )</text>
		</Macroline>
		<Macroline index="3">
			<text>SetUserVar $BPM = ( Song BPM ? )</text>
		</Macroline>
		<Macroline index="4">
			<text>SetUserVar $SeqMain = ( Main Sequence ? )</text>
		</Macroline>
		<Macroline index="5">
			<text>SetUserVar $ExtraStart = ( First Extra ? )</text>
		</Macroline>
		<Macroline index="6">
			<text>SetUserVar $ExtraEnd = ( Last Extra ? )</text>
		</Macroline>
		<Macroline index="7">
			<text>SetUserVar $MacroNum = ( Macro Number For Song ? )</text>
		</Macroline>
		<Macroline index="8">
			<text>Store Page $PageNum</text>
		</Macroline>
		<Macroline index="9">
			<text>Page $PageNum</text>
		</Macroline>
		<Macroline index="10">
			<text>Label Page $PageNum &quot;$SongName&quot;</text>
		</Macroline>
		<Macroline index="11">
			<text>Assign Sequence $SeqMain At Executor $PageNum.16</text>
		</Macroline>
		<Macroline index="12">
			<text>Label Sequence $SeqMain &quot;$SongName&quot;</text>
		</Macroline>
		<Macroline index="13">
			<text>Assign Sequence $ExtraStart Thru $ExtraEnd At Executor $PageNum.121 Thru $PageNum.130</text>
		</Macroline>
		<Macroline index="14">
			<text>Select Executor $PageNum.16</text>
		</Macroline>
		<Macroline index="15">
			<text>Store Cue 0.5 + 0.6 + 0.7 Executor $PageNum.16</text>
		</Macroline>
		<Macroline index="16">
			<text>Label Cue 0.5 &quot;Mise&quot; ; Label Cue 0.6 &quot;Select Timecode&quot; ; Label Cue 0.7 &quot;Go Timecode&quot;</text>
		</Macroline>
		<Macroline index="17">
			<text>Assign Cue 0.6 + 0.7 /trig=follow</text>
		</Macroline>
		<Macroline index="18">
			<text>Store Cue 1 Thru 20 Executor $PageNum.16</text>
		</Macroline>
		<Macroline index="19">
			<text>Store Cue 21 + 22 Executor $PageNum.16</text>
		</Macroline>
		<Macroline index="20">
			<text>Label Cue 21 &quot;Black Out&quot; ; Label Cue 22 &quot;Off Timecode&quot;</text>
		</Macroline>
		<Macroline index="21">
			<text>Assign Cue 22 /trig=follow</text>
		</Macroline>
		<Macroline index="22">
			<text>Store Macro 1.$MacroNum</text>
		</Macroline>
		<Macroline index="23">
			<text>Label Macro 1.$MacroNum &quot;$SongName&quot;</text>
		</Macroline>
		<Macroline index="24">
			<text>Store Macro 1.$MacroNum.1 ; Assign Macro 1.$MacroNum.1 /cmd=&quot;Off Page 1 Thru 100&quot;</text>
		</Macroline>
		<Macroline index="25">
			<text>Store Macro 1.$MacroNum.2 ; Assign Macro 1.$MacroNum.2 /cmd=&quot;Page $PageNum&quot;</text>
		</Macroline>
		<Macroline index="26">
			<text>Store Macro 1.$MacroNum.3 ; Assign Macro 1.$MacroNum.3 /cmd=&quot;Executor $PageNum.16 At 100&quot;</text>
		</Macroline>
		<Macroline index="27">
			<text>Store Macro 1.$MacroNum.4 ; Assign Macro 1.$MacroNum.4 /cmd=&quot;Goto Cue 0.5 Executor $PageNum.16&quot;</text>
		</Macroline>
		<Macroline index="28">
			<text>Store Macro 1.$MacroNum.5 ; Assign Macro 1.$MacroNum.5 /cmd=&quot;SpecialMaster 3.1 At $BPM&quot;</text>
		</Macroline>
	</Macro>
</MA>
